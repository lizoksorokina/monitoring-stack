# ─────────────────────────────────────────────────────────────────────────────
#  Скопируйте этот файл в .env  →  cp .env.example .env
#  .env в git не попадает (см. .gitignore), потому что там секреты.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ────────────────────────────────────────────────────────────────
# 1. В Telegram пишем @BotFather → /newbot → получаем токен вида 123456:AA...
TELEGRAM_BOT_TOKEN=

# 2. Свой chat_id можно узнать у бота @userinfobot (для лички)
#    или @RawDataBot (для группы, вида -1001234567890).
TELEGRAM_CHAT_ID=

# 3. Необязательно: id темы (topic) в супергруппе-форуме, куда складывать алерты.
TELEGRAM_THREAD_ID=

# true = бот не отправляет сообщения, а печатает их в лог.
# Удобно, чтобы поднять проект и всё посмотреть ДО создания бота.
TELEGRAM_DRY_RUN=false

# ── PostgreSQL (база демо-приложения) ──────────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_DB=orders

# ── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Адрес Grafana, который бот подставляет в кнопку-ссылку на дашборд.
# Если смотрите с Windows-браузера — localhost подойдёт.
GRAFANA_PUBLIC_URL=http://localhost:3000

# Адреса для ссылок в сообщениях бота (внутри Docker они другие, снаружи — эти).
PROMETHEUS_PUBLIC_URL=http://localhost:9090
ALERTMANAGER_PUBLIC_URL=http://localhost:9093
